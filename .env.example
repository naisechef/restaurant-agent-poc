# Required for live Claude API calls (not needed for unit tests)
ANTHROPIC_API_KEY=

# Cloud Run: inject via Secret Manager (--set-secrets), never bake into the image

# Optional overrides (defaults applied when unset)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TEMPERATURE=0.0  # optional; omitted when unset (not supported on claude-sonnet-5)
# ANTHROPIC_REQUEST_TIMEOUT=60
# CONFIDENCE_THRESHOLD=0.6
# DEFAULT_INPUT_PATH=data/restaurants.csv
# DEFAULT_OUTPUT_PATH=outputs/results.csv
# DEFAULT_REVIEW_QUEUE_PATH=outputs/review_queue.csv
# DEFAULT_GATHER_OUTPUT_PATH=outputs/gather_results.csv
# DEFAULT_GATHER_REVIEW_QUEUE_PATH=outputs/gather_review_queue.csv
# DEFAULT_FIXTURES_PATH=data/evidence_fixtures
# LOG_LEVEL=INFO
# LIVE_GOOGLE_REQUIRED=false  # when true, /ready requires GOOGLE_PLACES_API_KEY

# Required only for 'gather --live --source google' (not needed for unit tests
# or the default static/fake gather flow)
GOOGLE_PLACES_API_KEY=

# Optional overrides for the Google Places live adapter (defaults applied when unset)
# GOOGLE_PLACES_TIMEOUT=10
# GOOGLE_PLACES_MAX_REVIEWS=3
# GOOGLE_PLACES_REVIEW_SNIPPET_CHARS=300
